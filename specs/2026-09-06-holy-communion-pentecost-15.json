          ]
        },
        {
          "type": "lines",
          "lines": [
            "And the blessing of God,",
            "Creator, Liberator, and Sustainer,",
            "be with you always.",
            [
              "Amen.",
              "all"
            ]
          ]
        },
        {
          "type": "spacer"
        },
        {
          "type": "h2",
