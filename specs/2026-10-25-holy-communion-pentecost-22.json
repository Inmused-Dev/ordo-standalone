    {
      "label": "Gathering Hymn",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Gathering Hymn"
        },
        {
          "type": "h2",
          "text": "Joyful, Joyful"
        },
        {
          "type": "rubric",
          "text": "TIS 152",
          "margin": "16px 0 22px"
        },
        {
          "type": "hymn",
          "verses": [
            [
              "Joyful, joyful, we adore you,",
              "God of glory, God of love;",
              "hearts unfold like flowers before you,",
              "opening to the sun above.",
              "Melt the clouds of sin and sadness;",
              "drive the dark of doubt away;",
              "Giver of immortal gladness,",
              "fill us with the light of day!"
            ],
            [
              "All your works with joy surround you,",
              "earth and heav’n reflect your rays,",
              "stars and angels sing around you,",
              "centre of unbroken praise.",
              "Field and forest, vale and mountain,",
              "flowery meadow, flashing sea,",
              "singing bird and flowing fountain",
              "call to praise you joyfully."
            ],
            [
              "You are giving and forgiving,",
              "ever blessing, ever blest,",
              "well-spring of the joy of living,",
              "ocean-depth of happy rest!",
              "You our Father, Christ our Brother,",
              "all are yours who live in love;",
              "teach us how to love each other,",
              "lift us to your joy above."
            ]
          ]
        },
        {
          "type": "note",
          "text": "Henry van Dyke, 1907, alt. · CCLI Licence #309884"
        }
      ]
    },
    {
      "label": "Gathering",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Gathering in God’s Name"
        },
        {
          "type": "h2",
          "text": "Gathering in God’s Name"
        },
        {
          "type": "h3",
          "text": "Greeting"
        },
        {
          "type": "versicle",
          "call": "We are gathered in the name of the Father, the Son and the Holy Spirit.",
          "response": "Amen."
        },
        {
          "type": "versicle",
          "call": "The Lord be with you",
          "response": "And also with you"
        },
        {
          "type": "h3",
          "text": "Welcome & Introduction"
        },
        {
          "type": "spacer",
          "height": 10
        },
        {
          "type": "h3",
          "text": "Call to Worship"
        },
        {
          "type": "lines",
          "lines": [
            "Come, you who hunger for hope and wholeness.",
            [
              "God offers the bread of life, freely given.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "Come, you who thirst for forgiveness and peace.",
            [
              "Christ offers the living water, poured out for all.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "Come, you who carry burdens and long for rest.",
            [
              "The Spirit offers renewal, strength, and peace.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "margin": "0",
          "lines": [
            "Let us worship the One whose grace redeems and sustains.",
            [
              "Amen.",
              "all"
            ]
          ]
        }
      ]
    },
    {
      "label": "Receiving God’s Mercy",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Gathering in God’s Name"
        },
        {
          "type": "h2",
          "text": "Receiving God’s Mercy"
        },
        {
          "type": "h3",
          "text": "Invitation to Confession"
        },
        {
          "type": "lines",
          "lines": [
            "Friends, the gift of grace is already ours in Christ.",
            "Let us come to God with open hearts,",
            "trusting that mercy will meet us and love will restore us."
          ]
        },
        {
          "type": "h3",
          "text": "Confession"
        },
        {
          "type": "lines",
          "lines": [
            [
              "Loving God,",
              "all"
            ],
            [
              "we admit that we have done wrong:",
              "all"
            ],
            [
              "in our thoughts, words, and actions.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "Please forgive us.",
              "all"
            ],
            [
              "Help us to change,",
              "all"
            ],
            [
              "and guide us in the future.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "Help us to live justly,",
              "all"
            ],
            [
              "to show mercy,",
              "all"
            ],
            [
              "and to walk humbly with you.",
              "all"
            ],
            [
              "Amen.",
              "all"
            ]
          ]
        },
        {
          "type": "h3",
          "text": "Absolution"
        },
        {
          "type": "lines",
          "lines": [
            "God, who is full of love and power,",
            "forgives you and sets you free.",
            "The Holy Spirit heals, strengthens, and guides you,",
            "so you may walk in new life in Christ."
          ]
        },
        {
          "type": "lines",
          "margin": "0",
          "lines": [
            [
              "Amen.",
              "all"
            ]
          ]
        }
      ]
    },
    {
      "label": "Giving Praise",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Gathering in God’s Name"
        },
        {
          "type": "h2",
          "text": "Giving Praise"
        },
        {
          "type": "rubric",
          "text": "Mercy Restores",
          "margin": "0 0 20px"
        },
        {
          "type": "lines",
          "lines": [
            "We give thanks to you, gracious God,",
            [
              "for your mercy restores and your grace makes us whole.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "You have drawn near in every age—",
            [
              "freeing the captives, forgiving the broken, feeding the hungry.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "From the beginning you made the world in goodness,",
            [
              "a gift of grace where salvation is written in every living thing.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "In Jesus, your Word became flesh,",
            [
              "bringing salvation to the world and grace upon grace.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            "By your Spirit, you breathe life into our weary souls",
            [
              "and set us again on the path of joy.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "margin": "0",
          "lines": [
            "We give you thanks and praise,",
            [
              "now and always. Amen.",
              "all"
            ]
          ]
        }
      ]
    },
    {
      "label": "Prayer of the Day",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Bible and Teaching"
        },
        {
          "type": "h2",
          "text": "Prayer of the Day"
        },
        {
          "type": "lines",
          "margin": "22px 0 0",
          "lines": [
            "Holy God,",
            "you call us to be holy as you are holy,",
            "and show us that holiness looks like love:",
            "for you with all that we are,",
            "and for our neighbour as for ourselves.",
            "Where we have made love smaller than your law,",
            "widen our hearts to the measure of your own;",
            "through Jesus Christ our Lord.",
            [
              "Amen.",
              "all"
            ]
          ]
        }
      ]
    },
    {
      "label": "Leviticus 19",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Bible and Teaching"
        },
        {
          "type": "h2",
          "text": "Readings"
        },
        {
          "type": "rubric",
          "text": "Readings are from the Common English Bible.",
          "margin": "16px 0 0"
        },
        {
          "type": "worktitle",
          "text": "Leviticus 19:1–2, 15–18",
          "sub": "First reading",
          "margin": "30px 0 18px"
        },
        {
          "type": "lines",
          "margin": "0 0 20px",
          "lines": [
            "A reading from the book of Leviticus."
          ]
        },
        {
          "type": "prose",
          "margin": "0 0 22px",
          "paragraphs": [
            "The Lord said to Moses, Say to the whole community of the Israelites: You must be holy, because I, the Lord your God, am holy.",
            "You must not act unjustly in a legal case. Do not show favoritism to the poor or deference to the great; you must judge your fellow Israelites fairly. Do not go around slandering your people. Do not stand by while your neighbor’s blood is shed; I am the Lord. You must not hate your fellow Israelite in your heart. Rebuke your fellow Israelite strongly, so you don’t become responsible for his sin. You must not take revenge nor hold a grudge against any of your people; instead, you must love your neighbor as yourself; I am the Lord."
          ]
        },
        {
          "type": "versicle",
          "call": "This is the word of the Lord",
          "response": "Thanks be to God",
          "margin": "0"
        }
      ]
    },
    {
      "label": "Gospel",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Bible and Teaching"
        },
        {
          "type": "h2",
          "text": "Gospel"
        },
        {
          "type": "worktitle",
          "text": "Matthew 22:34–46",
          "margin": "22px 0 18px"
        },
        {
          "type": "lines",
          "lines": [
            {
              "segments": [
                [
                  "Alleluia! ",
                  ""
                ],
                [
                  "Alleluia!",
                  "all"
                ]
              ]
            },
            {
              "segments": [
                [
                  "You must love your neighbor as you love yourself, says the Lord. ",
                  ""
                ],
                [
                  "Alleluia!",
                  "all"
                ]
              ]
            }
          ]
        },
        {
          "type": "versicle",
          "call": "The Lord be with you",
          "response": "And also with you"
        },
        {
          "type": "versicle",
          "call": "A reading from the Good News according to Matthew.",
          "response": "Glory to you Lord Jesus Christ"
        },
        {
          "type": "prose",
          "margin": "0 0 22px",
          "paragraphs": [
            "When the Pharisees heard that Jesus had left the Sadducees speechless, they met together. One of them, a legal expert, tested him. “Teacher, what is the greatest commandment in the Law?”",
            "He replied, “You must love the Lord your God with all your heart, with all your being, and with all your mind. This is the first and greatest commandment. And the second is like it: You must love your neighbor as you love yourself. All the Law and the Prophets depend on these two commands.”",
            "Now as the Pharisees were gathering, Jesus asked them, “What do you think about the Christ? Whose son is he?”",
            "“David’s son,” they replied.",
            "He said, “Then how is it that David, inspired by the Holy Spirit, called him Lord when he said, The Lord said to my lord, ‘Sit at my right side until I turn your enemies into your footstool’? If David calls him Lord, how can he be David’s son?” Nobody was able to answer him. And from that day forward nobody dared to ask him anything."
          ]
        },
        {
          "type": "versicle",
          "call": "This is the good news of the Lord",
          "response": "Praise to you Lord Jesus Christ",
          "margin": "0"
        }
      ]
    },
    {
      "label": "Sermon & Affirmation",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Bible and Teaching"
        },
        {
          "type": "h2",
          "text": "Sermon"
        },
        {
          "type": "spacer"
        },
        {
          "type": "h2",
          "text": "Affirmation"
        },
        {
          "type": "lines",
          "margin": "22px 0 24px",
          "lines": [
            [
              "We believe in God,",
              "all"
            ],
            [
              "maker of all,",
              "all"
            ],
            [
              "who raised Jesus to life",
              "all"
            ],
            [
              "and brings new life to the world.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "We believe in Christ,",
              "all"
            ],
            [
              "crucified and risen,",
              "all"
            ],
            [
              "alive forever—",
              "all"
            ],
            [
              "calling us to justice, joy, and peace.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "We believe the Spirit is with us,",
              "all"
            ],
            [
              "opening hearts,",
              "all"
            ],
            [
              "renewing minds,",
              "all"
            ],
            [
              "and breathing life into all creation.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "We believe the Church is Christ’s body—",
              "all"
            ],
            [
              "diverse, united,",
              "all"
            ],
            [
              "and welcoming all.",
              "all"
            ],
            [
              "We affirm the dignity of every person,",
              "all"
            ],
            [
              "and are called to love without exception.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "margin": "0",
          "lines": [
            [
              "This is our faith,",
              "all"
            ],
            [
              "our hope,",
              "all"
            ],
            [
              "our joy.",
              "all"
            ],
            [
              "Amen.",
              "all"
            ]
          ]
        }
      ]
    },
    {
      "label": "Prayers & Peace",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Prayers and Peace"
        },
        {
          "type": "h2",
          "text": "Prayers of the People"
        },
        {
          "type": "h3",
          "text": "Intercessions"
        },
        {
          "type": "rubric",
          "text": "Led by the intercessor. Everyone responds to each petition with:"
        },
        {
          "type": "versicle",
          "call": "Lord in your mercy",
          "response": "Hear our prayer"
        },
        {
          "type": "h3",
          "text": "Prayer for St Aidan’s"
        },
        {
          "type": "lines",
          "lines": [
            [
              "God of Mission,",
              "all"
            ],
            [
              "you call us to share your love.",
              "all"
            ],
            [
              "Send your Holy Spirit to guide us",
              "all"
            ],
            [
              "in deepening our discipleship,",
              "all"
            ],
            [
              "in welcoming everyone,",
              "all"
            ],
            [
              "and in sharing your love with courage.",
              "all"
            ]
          ]
        },
        {
          "type": "lines",
          "lines": [
            [
              "Help St Aidan’s grow",
              "all"
            ],
            [
              "in faith, diversity,",
              "all"
            ],
            [
              "and service to our community.",
              "all"
            ]
          ]
        },
        {
          "type": "h3",
          "text": "Conclusion to Prayers"
        },
        {
          "type": "lines",
          "lines": [
            "Loving God, you hear our prayers.",
            [
              "By your Spirit,",
              "all"
            ],
            [
              "guide us to live with open hearts,",
              "all"
            ],
            [
              "trusting in your presence",
              "all"
            ],
            [
              "and grace,",
              "all"
            ],
            [
              "through Jesus Christ our Lord. Amen.",
              "all"
            ]
          ]
        },
        {
          "type": "spacer"
        },
        {
          "type": "h2",
          "text": "Greeting of Peace"
        },
        {
          "type": "versicle",
          "call": "We are the body of Christ",
          "response": "His Spirit is with us",
          "margin": "22px 0 24px"
        },
        {
          "type": "versicle",
          "call": "The peace of the Lord be with you",
          "response": "And also with you",
          "margin": "0"
        }
      ]
    },
    {
      "label": "Offertory Hymn (1–4)",
      "blocks": [
        {
          "type": "eyebrow",
          "text": "Offertory"
        },
        {
          "type": "h2",
          "text": "When I Needed a Neighbour"
        },
        {
          "type": "rubric",
          "text": "TIS 629",
          "margin": "16px 0 22px"
        },
        {
          "type": "hymn",
          "verses": [
            [
              "When I needed a neighbour,",
              "were you there,",
              "were you there?",
              "When I needed a neighbour,",
              "were you there?",
              "And the creed and the colour",
              "and the name won’t matter,",
              "were you there?"
            ],
            [
              "I was hungry and thirsty,",
              "were you there,",
              "were you there?",
              "I was hungry and thirsty,",
              "were you there?",
              "And the creed and the colour",
              "and the name won’t matter,",
              "were you there?"
            ],
            [
              "I was cold, I was naked,",
              "were you there,",
              "were you there?",
              "I was cold, I was naked,",
              "were you there?",
              "And the creed and the colour",
              "and the name won’t matter,",
              "were you there?"
            ],
            [
              "When I needed a shelter,",
              "were you there,",
              "were you there?",
              "When I needed a shelter,",
              "were you there?",
              "And the creed and the colour",
              "and the name won’t matter,",
              "were you there?"
            ]
          ]
        }
      ]
    },
    {
