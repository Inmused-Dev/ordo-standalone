        },
        {
          "type": "hymn",
          "verses": [
            [
              "When I needed a healer,",
              "were you there,",
              "were you there?",
              "When I needed a healer,",
              "were you there?",
              "And the creed and the colour",
              "and the name won’t matter,",
              "were you there?"
            ],
            [
              "When they put me in prison,",
