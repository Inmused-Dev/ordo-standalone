  {
   "label": "Gathering Hymn (1–2)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Gathering Hymn"
    },
    {
     "type": "h2",
     "text": "Let All Mortal Flesh Keep Silence"
    },
    {
     "type": "rubric",
     "text": "TIS 152 · verses 1–2",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Let all mortal flesh keep silence",
       "and with fear and trembling stand;",
       "ponder nothing earthly-minded,",
       "for with blessing in his hand",
       "Christ our God to earth descending",
       "comes full homage to demand."
      ],
      [
       "King of kings, yet born of Mary,",
       "as of old on earth he stood,",
       "Lord of lords, in human vesture,",
       "in the body and the blood,",
       "he will give to all the faithful",
       "his own self for heavenly food."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Gathering Hymn (3–4)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Gathering Hymn"
    },
    {
     "type": "h2",
     "text": "Let All Mortal Flesh Keep Silence"
    },
    {
     "type": "rubric",
     "text": "TIS 152 · verses 3–4",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Rank on rank the host of heaven",
       "spreads its vanguard on the way,",
       "as the Light of light comes shining",
       "from the realms of endless day,",
       "that the powers of hell may vanish",
       "as the darkness clears away."
      ],
      [
       "At his feet the six-winged seraphs,",
       "cherubim with sleepless eye,",
       "veil their faces to the presence,",
       "as with ceaseless voice they cry,",
       "alleluia, alleluia,",
       "alleluia, Lord most high!"
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Gathering",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Gathering in God’s Name"
    },
    {
     "type": "h2",
     "text": "Gathering in God’s Name"
    },
    {
     "type": "h3",
     "text": "Greeting"
    },
    {
     "type": "versicle",
     "call": "We are gathered in the name of the Father, the Son and the Holy Spirit.",
     "response": "Amen"
    },
    {
     "type": "versicle",
     "call": "The Lord be with you",
     "response": "And also with you"
    },
    {
     "type": "h3",
     "text": "Welcome & Introduction"
    },
    {
     "type": "spacer",
     "height": 10
    },
    {
     "type": "h3",
     "text": "Call to Worship"
    },
    {
     "type": "lines",
     "lines": [
      "Come, you who hunger for hope and wholeness.",
      [
       "God offers the bread of life, freely given.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "Come, you who thirst for forgiveness and peace.",
      [
       "Christ offers the living water, poured out for all.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "Come, you who carry burdens and long for rest.",
      [
       "The Spirit offers renewal, strength, and peace.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "Let us worship the One whose grace redeems and sustains.",
      [
       "Amen.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Receiving God’s Mercy",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Receiving God’s Mercy"
    },
    {
     "type": "h2",
     "text": "Receiving God’s Mercy"
    },
    {
     "type": "h3",
     "text": "Invitation to Confession"
    },
    {
     "type": "lines",
     "lines": [
      "Friends, the gift of grace",
      "is already ours in Christ.",
      "Let us come to God with open hearts,",
      "trusting that mercy will meet us",
      "and love will restore us."
     ]
    },
    {
     "type": "h3",
     "text": "Confession"
    },
    {
     "type": "lines",
     "lines": [
      [
       "Loving God,",
       "all"
      ],
      [
       "we admit that we have done wrong:",
       "all"
      ],
      [
       "in our thoughts, words, and actions.",
       "all"
      ],
      [
       "Please forgive us.",
       "all"
      ],
      [
       "Help us to change,",
       "all"
      ],
      [
       "and guide us in the future.",
       "all"
      ],
      [
       "Help us to live justly,",
       "all"
      ],
      [
       "to show mercy,",
       "all"
      ],
      [
       "and to walk humbly with you.",
       "all"
      ],
      [
       "Amen.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Absolution"
    },
    {
     "type": "lines",
     "lines": [
      "God, who is full of love and power,",
      "forgives you and sets you free.",
      "The Holy Spirit heals,",
      "strengthens, and guides you,",
      "so you may walk in new life in Christ.",
      [
       "Amen.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Giving Praise",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Giving Praise"
    },
    {
     "type": "h2",
     "text": "Giving Praise"
    },
    {
     "type": "lines",
     "lines": [
      "We give thanks to you, gracious God,",
      [
       "for your mercy restores",
       "all"
      ],
      [
       "and your grace makes us whole.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "You have drawn near in every age—",
      [
       "freeing the captives, forgiving the broken,",
       "all"
      ],
      [
       "feeding the hungry.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "From the beginning you made the world in goodness,",
      [
       "a gift of grace where salvation",
       "all"
      ],
      [
       "is written in every living thing.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "In Jesus, your Word became flesh,",
      [
       "bringing salvation to the world",
       "all"
      ],
      [
       "and grace upon grace.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "By your Spirit, you breathe life into our weary souls",
      [
       "and set us again on the path of joy.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "We give you thanks and praise,",
      [
       "now and always. Amen.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Prayer of the Day",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Prayer of the Day"
    },
    {
     "type": "h2",
     "text": "Prayer of the Day"
    },
    {
     "type": "lines",
     "lines": [
      "Faithful God,",
      "you entrust us with the riches of your grace",
      "and call us to stand awake before your coming day:",
      "free us from the fear that buries what you have given,",
      "and from the ease that says you will do nothing;",
      "make us bold to spend ourselves for your kingdom,",
      "that we may enter into the joy of our master;",
      "through Jesus Christ our Lord.",
      [
       "Amen.",
       "all"
      ]
     ],
     "margin": "22px 0 0"
    }
   ]
  },
  {
   "label": "Zephaniah 1",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Bible and Teaching"
    },
    {
     "type": "h2",
     "text": "Readings"
    },
    {
     "type": "rubric",
     "text": "Readings are from the Common English Bible.",
     "margin": "16px 0 0"
    },
    {
     "type": "worktitle",
     "text": "Zephaniah 1:7, 12–18",
     "sub": "First reading",
     "margin": "30px 0 18px"
    },
    {
     "type": "lines",
     "lines": [
      "A reading from the prophet Zephaniah."
     ],
     "margin": "0 0 20px"
    },
    {
     "type": "lines",
     "lines": [
      "Hush before the Lord God,",
      "for the day of the Lord is near!",
      "The Lord has established a sacrifice;",
      "he has made holy those he has summoned."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "At that time, I will search Jerusalem with lamps;",
      "I will punish the men growing fat on the sediment in their wine,",
      "those saying to themselves, The Lord won’t do good or evil."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "Their wealth will be looted and their houses destroyed.",
      "They will rebuild houses, but not live in them;",
      "they will plant vineyards, but not drink the wine."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "The great day of the Lord is near;",
      "it is near and coming very quickly.",
      "The sound of the day of the Lord is bitter.",
      "A warrior screams there."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "That day is a day of fury,",
      "a day of distress and anxiety,",
      "a day of desolation and devastation,",
      "a day of darkness and gloominess,",
      "a day of clouds and deep darkness,",
      "a day for blowing the trumpet and alarm against their invincible cities",
      "and against their high towers."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "I will make humanity suffer;",
      "they will walk like the blind",
      "because they sinned against the Lord.",
      "Their blood will be poured out like dust",
      "and their intestines like manure."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "Moreover, their silver and their gold won’t be able to deliver them",
      "on the day of the Lord’s fury.",
      "His jealousy will devour the entire land with fire;",
      "he will make an end,",
      "a truly horrible one,",
      "for all the inhabitants of the land."
     ],
     "margin": "0 0 22px"
    },
    {
     "type": "versicle",
     "call": "This is the word of the Lord",
     "response": "Thanks be to God",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Gospel",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Bible and Teaching"
    },
    {
     "type": "h2",
     "text": "Gospel"
    },
    {
     "type": "worktitle",
     "text": "Matthew 25:14–30",
     "margin": "22px 0 18px"
    },
    {
     "type": "lines",
     "lines": [
      {
       "segments": [
        [
         "Alleluia! ",
         ""
        ],
        [
         "Alleluia!",
         "all"
        ]
       ]
      },
      {
       "segments": [
        [
         "Well done, good and faithful servant. ",
         ""
        ],
        [
         "Alleluia!",
         "all"
        ]
       ]
      }
     ]
    },
    {
     "type": "versicle",
     "call": "The Lord be with you",
     "response": "And also with you"
    },
    {
     "type": "versicle",
     "call": "A reading from the Good News according to Matthew.",
     "response": "Glory to you Lord Jesus Christ"
    },
    {
     "type": "prose",
     "margin": "0 0 22px",
     "paragraphs": [
      "“The kingdom of heaven is like a man who was leaving on a trip. He called his servants and handed his possessions over to them. To one he gave five valuable coins, and to another he gave two, and to another he gave one. He gave to each servant according to that servant’s ability. Then he left on his journey.",
      "“After the man left, the servant who had five valuable coins took them and went to work doing business with them. He gained five more. In the same way, the one who had two valuable coins gained two more. But the servant who had received the one valuable coin dug a hole in the ground and buried his master’s money.",
      "“Now after a long time the master of those servants returned and settled accounts with them. The one who had received five valuable coins came forward with five additional coins. He said, ‘Master, you gave me five valuable coins. Look, I’ve gained five more.’",
      "“His master replied, ‘Excellent! You are a good and faithful servant! You’ve been faithful over a little. I’ll put you in charge of much. Come, celebrate with me.’",
      "“The second servant also came forward and said, ‘Master, you gave me two valuable coins. Look, I’ve gained two more.’",
      "“His master replied, ‘Well done! You are a good and faithful servant. You’ve been faithful over a little. I’ll put you in charge of much. Come, celebrate with me.’",
      "“Now the one who had received one valuable coin came and said, ‘Master, I knew that you are a hard man. You harvest grain where you haven’t sown. You gather crops where you haven’t spread seed. So I was afraid. And I hid my valuable coin in the ground. Here, you have what’s yours.’",
      "“His master replied, ‘You evil and lazy servant! You knew that I harvest grain where I haven’t sown and that I gather crops where I haven’t spread seed? In that case, you should have turned my money over to the bankers so that when I returned, you could give me what belonged to me with interest. Therefore, take from him the valuable coin and give it to the one who has ten coins. Those who have much will receive more, and they will have more than they need. But as for those who don’t have much, even the little bit they have will be taken away from them. Now take the worthless servant and throw him out into the farthest darkness.’",
      "“People there will be weeping and grinding their teeth.”"
     ]
    },
    {
     "type": "versicle",
     "call": "This is the good news of the Lord",
     "response": "Praise to you Lord Jesus Christ",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Sermon & Affirmation",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Ministry of the Word"
    },
    {
     "type": "h2",
     "text": "Sermon"
    },
    {
     "type": "spacer",
     "height": 10
    },
    {
     "type": "h2",
     "text": "Affirmation"
    },
    {
     "type": "lines",
     "lines": [
      [
       "We believe in God,",
       "all"
      ],
      [
       "maker of all,",
       "all"
      ],
      [
       "who raised Jesus to life",
       "all"
      ],
      [
       "and brings new life to the world.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "We believe in Christ,",
       "all"
      ],
      [
       "crucified and risen,",
       "all"
      ],
      [
       "alive forever—",
       "all"
      ],
      [
       "calling us to justice, joy, and peace.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "We believe the Spirit is with us,",
       "all"
      ],
      [
       "opening hearts,",
       "all"
      ],
      [
       "renewing minds,",
       "all"
      ],
      [
       "and breathing life into all creation.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "We believe the Church is Christ’s body—",
       "all"
      ],
      [
       "diverse, united,",
       "all"
      ],
      [
       "and welcoming all.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "We affirm the dignity of every person,",
       "all"
      ],
      [
       "and are called to love without exception.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "This is our faith,",
       "all"
      ],
      [
       "our hope,",
       "all"
      ],
      [
       "our joy.",
       "all"
      ],
      [
       "Amen.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Prayers & Peace",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Prayers of the People"
    },
    {
     "type": "h2",
     "text": "Intercessions"
    },
    {
     "type": "rubric",
     "text": "Led by the intercessor. Everyone responds to each petition with:",
     "margin": "10px 0 14px"
    },
    {
     "type": "versicle",
     "call": "Lord in your mercy",
     "response": "Hear our prayer"
    },
    {
     "type": "h3",
     "text": "Prayer for St Aidan’s"
    },
    {
     "type": "lines",
     "lines": [
      [
       "God of mission,",
       "all"
      ],
      [
       "you call us to share your love.",
       "all"
      ],
      [
       "Send your Holy Spirit to guide us",
       "all"
      ],
      [
       "in deepening our discipleship,",
       "all"
      ],
      [
       "in welcoming everyone,",
       "all"
      ],
      [
       "and in sharing your love with courage.",
       "all"
      ],
      [
       "Help St Aidan’s grow",
       "all"
      ],
      [
       "in faith, diversity,",
       "all"
      ],
      [
       "and service to our community.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Conclusion to Prayers"
    },
    {
     "type": "lines",
     "lines": [
      "Loving God, you hear our prayers.",
      [
       "By your Spirit,",
       "all"
      ],
      [
       "guide us to live with open hearts,",
       "all"
      ],
      [
       "trusting in your presence and grace,",
       "all"
      ],
      [
       "through Jesus Christ our Lord. Amen.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Greeting of Peace"
    },
    {
     "type": "versicle",
     "call": "We are the body of Christ",
     "response": "His Spirit is with us"
    },
    {
     "type": "versicle",
     "call": "The peace of the Lord be with you",
     "response": "And also with you",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Offertory Hymn (1–3)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Offertory Hymn"
    },
    {
     "type": "h2",
     "text": "Take My Life"
    },
    {
     "type": "rubric",
     "text": "TIS 599 · verses 1–3",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Take my life, and let it be",
       "consecrated, Lord, to thee:",
       "take my moments and my days,",
       "let them flow in ceaseless praise."
      ],
      [
       "Take my hands, and let them move",
       "at the impulse of thy love:",
       "take my feet, and let them be",
       "swift and beautiful for thee."
      ],
      [
       "Take my voice, and let me sing,",
       "always, only, for my King:",
       "take my lips, and let them be",
       "filled with messages from thee."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Offertory Hymn (4–6)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Offertory Hymn"
    },
    {
     "type": "h2",
     "text": "Take My Life"
    },
    {
     "type": "rubric",
     "text": "TIS 599 · verses 4–6",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Take my silver and my gold;",
       "nothing, Lord, would I withhold:",
       "take my intellect, and use",
       "every power as thou shalt choose."
      ],
      [
       "Take my will, and make it thine;",
       "it shall be no longer mine:",
       "take my heart—it is thine own;",
       "it shall be thy royal throne."
      ],
      [
       "Take my love; my Lord, I pour",
       "at thy feet its treasure-store:",
       "take myself, and I will be,",
       "ever, only, all for thee."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Introduction to Communion",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "The Thanksgiving Prayer"
    },
    {
     "type": "h2",
     "text": "Introduction to Communion"
    },
    {
     "type": "lines",
     "lines": [
      "Here we gather now at Christ’s table—",
      "a table of grace and salvation.",
      "Here we remember his story.",
      "Here we give thanks.",
      "Everyone is welcome.",
      "Come as you are."
     ],
     "margin": "22px 0 30px"
    },
    {
     "type": "versicle",
     "call": "The Lord be with you.",
     "response": "And also with you"
    },
    {
     "type": "versicle",
     "call": "Lift up your hearts.",
     "response": "We lift them to the Lord."
    },
    {
     "type": "versicle",
     "call": "Let us give thanks to the Lord our God.",
     "response": "It is right to give our thanks and praise.",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Preface",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "The Thanksgiving Prayer"
    },
    {
     "type": "h2",
     "text": "Preface"
    },
    {
     "type": "lines",
     "lines": [
      "It is right to give you thanks,",
      "God of unending mercy and love."
     ],
     "margin": "22px 0 24px"
    },
    {
     "type": "lines",
     "lines": [
      "From the beginning, you created",
      "a world of beauty and goodness,",
      "and you called us to live in your light.",
      "When we turned away, you did not abandon us.",
      "Through prophets and poets,",
      "you spoke of your steadfast love."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "In Jesus Christ, you came among us,",
      "full of grace and truth,",
      "offering yourself as the bread of life",
      "for the salvation of the world."
     ]
    },
    {
     "type": "lines",
     "lines": [
      "So with all who are fed by your mercy,",
      "we give you thanks and praise, saying together:"
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "Blessed is our God,",
       "all"
      ],
      [
       "who saves and renews,",
       "all"
      ],
      [
       "whose grace is our daily bread.",
       "all"
      ],
      [
       "Blessed is our God, forever.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Words of Institution",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "The Thanksgiving Prayer"
    },
    {
     "type": "h2",
     "text": "Words of Institution"
    },
    {
     "type": "h3",
     "text": "Bread"
    },
    {
     "type": "lines",
     "lines": [
      "On the night before he died,",
      "Jesus shared a meal with his friends.",
      "He took bread,",
      "gave thanks,",
      "broke it, and said:",
      "Take, eat.",
      "This is my body, given for you.",
      "Do this to remember me.",
      [
       "Lord my God.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Wine"
    },
    {
     "type": "lines",
     "lines": [
      "After supper, he took the cup,",
      "gave thanks, and said:",
      "Drink this, all of you.",
      "This is my blood of the new covenant,",
      "poured out for you and for all,",
      "for the forgiveness of sin.",
      "Do this to remember me.",
      [
       "Lord my God.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Acclamation to Sanctus",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "The Thanksgiving Prayer"
    },
    {
     "type": "h2",
     "text": "Mystery of Faith"
    },
    {
     "type": "lines",
     "lines": [
      "Let us proclaim the mystery of faith.",
      [
       "Christ has died to set us free.",
       "all"
      ],
      [
       "Christ is risen to make us whole.",
       "all"
      ],
      [
       "Christ will come again with justice and joy.",
       "all"
      ]
     ],
     "margin": "22px 0 24px"
    },
    {
     "type": "lines",
     "lines": [
      "Send your Spirit of life,",
      "that this bread and this cup",
      "may be for us the body and blood of Christ.",
      [
       "As we eat and drink,",
       "all"
      ],
      [
       "renew your people in love,",
       "all"
      ],
      [
       "make us one body in Christ,",
       "all"
      ],
      [
       "our Saviour and Lord.",
       "all"
      ]
     ]
    },
    {
     "type": "lines",
     "lines": [
      "With your Church across all of creation,",
      "we give you thanks and praise,",
      "joining the unending song:"
     ]
    },
    {
     "type": "lines",
     "lines": [
      [
       "Holy, holy, holy Lord,",
       "all"
      ],
      [
       "God of power and might,",
       "all"
      ],
      [
       "heaven and earth are full of your glory.",
       "all"
      ],
      [
       "Praise to you in the highest.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Lord’s Prayer to Invitation",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Sharing the Bread"
    },
    {
     "type": "h2",
     "text": "The Lord’s Prayer"
    },
    {
     "type": "lines",
     "lines": [
      [
       "Father, uphold the holiness of your name.",
       "all"
      ],
      [
       "Bring in your kingdom.",
       "all"
      ],
      [
       "Give us the bread we need for today.",
       "all"
      ],
      [
       "Forgive us our sins,",
       "all"
      ],
      [
       "for we also forgive everyone who has wronged us.",
       "all"
      ],
      [
       "And save us in times of trial.",
       "all"
      ],
      [
       "For you are worthy,",
       "all"
      ],
      [
       "our Lord and God,",
       "all"
      ],
      [
       "to receive glory and honour and power,",
       "all"
      ],
      [
       "because you created all things.",
       "all"
      ],
      [
       "Amen.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Breaking the Bread"
    },
    {
     "type": "lines",
     "lines": [
      "This bread is broken,",
      "for Jesus gave himself for us.",
      [
       "In this act of love, we are made whole.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Invitation to Communion"
    },
    {
     "type": "lines",
     "lines": [
      "The gifts of God for the people of God.",
      [
       "Graciously nourish us, O Christ,",
       "all"
      ],
      [
       "so that we who try to follow you",
       "all"
      ],
      [
       "may receive food for the journey",
       "all"
      ],
      [
       "and be bound in solidarity",
       "all"
      ],
      [
       "with all who walk in your way.",
       "all"
      ],
      [
       "Amen.",
       "all"
      ]
     ],
     "margin": "0"
    }
   ]
  },
  {
   "label": "Communion Anthem",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Communion Anthem"
    },
    {
     "type": "h2",
     "text": "Jesus Christ, Be the Wine of Grace"
    },
    {
     "type": "rubric",
     "text": "Verses 1–2",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "In the singing, in the silence,",
       "in the hands expectant, open,",
       "in the blessing, in the breaking,",
       "in the presence at this table",
       "Jesus Christ, Jesus Christ,",
       "be the wine of grace.",
       "Jesus Christ, Jesus Christ,",
       "be the bread of peace."
      ],
      [
       "In the question, in the answer,",
       "in the moment of acceptance,",
       "in the heart’s cry, in the healing,",
       "in the circle of your people.",
       "Jesus Christ, Jesus Christ,",
       "be the wine of grace.",
       "Jesus Christ, Jesus Christ,",
       "be the bread of peace."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Receiving Communion (1–2)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Receiving Communion"
    },
    {
     "type": "h2",
     "text": "Be Not Afraid"
    },
    {
     "type": "rubric",
     "text": "John Michael Talbot · verses 1–2",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "You shall cross the barren desert,",
       "but you shall not die of thirst.",
       "You shall wander far in safety",
       "though you do not know the way.",
       "You shall speak your words in foreign",
       "lands and all will understand.",
       "You shall see the face of God and live."
      ],
      [
       "Be not afraid.",
       "I go before you always.",
       "Come follow me, and",
       "I will give you rest."
      ],
      [
       "If you pass through raging waters",
       "in the sea, you shall not drown.",
       "If you walk amid the burning",
       "flames, you shall not be harmed.",
       "If you stand before the pow’r of hell",
       "and death is at your side, know that",
       "I am with you through it all."
      ],
      [
       "Be not afraid.",
       "I go before you always.",
       "Come follow me, and",
       "I will give you rest."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Receiving Communion (3)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Receiving Communion"
    },
    {
     "type": "h2",
     "text": "Be Not Afraid"
    },
    {
     "type": "rubric",
     "text": "John Michael Talbot · verse 3",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Blessed are your poor, for",
       "the kingdom shall be theirs.",
       "Blessed are you that weep and",
       "mourn, for one day you shall laugh.",
       "And if wicked men insult and",
       "hate you all because of me,",
       "blessed, blessed are you!"
      ],
      [
       "Be not afraid.",
       "I go before you always.",
       "Come follow me, and",
       "I will give you rest."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Sending Out",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Sending Out"
    },
    {
     "type": "h2",
     "text": "Prayer after Communion"
    },
    {
     "type": "lines",
     "lines": [
      "Saving God,",
      "we thank you for feeding us",
      "with grace beyond measure.",
      "Send us out to share this gift freely,",
      "so that all may know your love and salvation."
     ]
    },
    {
     "type": "h3",
     "text": "Gratitude for Communion"
    },
    {
     "type": "lines",
     "lines": [
      [
       "Lord,",
       "all"
      ],
      [
       "we have broken your bread",
       "all"
      ],
      [
       "and received your life.",
       "all"
      ],
      [
       "By the power of your Spirit",
       "all"
      ],
      [
       "keep us always in your love",
       "all"
      ],
      [
       "through Jesus Christ our Lord.",
       "all"
      ],
      [
       "Amen.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "This Week at St Aidan’s"
    },
    {
     "type": "rubric",
     "text": "Notices",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Blessing & Dismissal",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Sending Out"
    },
    {
     "type": "h2",
     "text": "Blessing"
    },
    {
     "type": "versicle",
     "call": "The Lord be with you",
     "response": "And also with you"
    },
    {
     "type": "lines",
     "lines": [
      "May the God of grace fill you with peace,",
      "the Christ of salvation walk beside you,",
      "and the Spirit of life guide you always.",
      [
       "Amen.",
       "all"
      ]
     ]
    },
    {
     "type": "h3",
     "text": "Dismissal"
    },
    {
     "type": "versicle",
     "call": "Go in peace, to love and serve the Lord",
     "response": "In the name of Christ. Amen.",
     "margin": "0"
    }
   ]
  },
  {
   "label": "Sending Hymn (1–2)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Sending Hymn"
    },
    {
     "type": "h2",
     "text": "Immortal, Invisible"
    },
    {
     "type": "rubric",
     "text": "TIS 143 · verses 1–2",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Immortal, invisible,",
       "God only wise,",
       "in light inaccessible",
       "hid from our eyes,",
       "most blessèd, most glorious,",
       "the Ancient of Days,",
       "almighty, victorious,",
       "your great name we praise."
      ],
      [
       "Unresting, unhasting,",
       "and silent as light,",
       "nor wanting, nor wasting,",
       "but ruling in might;",
       "your justice, like mountains,",
       "high soaring above",
       "your clouds, which are fountains",
       "of goodness and love."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  },
  {
   "label": "Sending Hymn (3–4)",
   "blocks": [
    {
     "type": "eyebrow",
     "text": "Sending Hymn"
    },
    {
     "type": "h2",
     "text": "Immortal, Invisible"
    },
    {
     "type": "rubric",
     "text": "TIS 143 · verses 3–4",
     "margin": "16px 0 22px"
    },
    {
     "type": "hymn",
     "verses": [
      [
       "Great Father of glory,",
       "pure Father of light,",
       "your angels adore you,",
       "all veiling their sight;",
       "of all your rich graces",
       "this grace, Lord, impart:",
       "take the veil from our faces,",
       "the veil from our heart."
      ],
      [
       "All praise we would render;",
       "reveal to our sight",
       "what hides you is only",
       "the splendour of light;",
       "and so let your glory,",
       "almighty, impart,",
       "through Christ in the story,",
       "your Christ to the heart."
      ]
     ]
    },
    {
     "type": "note",
     "text": "CCLI Licence #309884"
    }
   ]
  }
 ]
}